# Copy with `make setup`; it generates local API and AMI secrets.
CORE_HOST=127.0.0.1
PORT=8080
CORE_URL=http://127.0.0.1:8080
CORE_API_TOKEN=
DATABASE_PATH=var/tochka.db
# Empty: discover the single .xlsx file in data/.
SCHEDULE_PATH=

# Empty token: persistent local mock with all doctors from the workbook.
MIS_API_TOKEN=
MIS_API_URL=https://crm-med-mock.dbi-testing.ru/api/v1

# Optional NLU fallback. Gemini sends the current text utterance and state to Google.
# Enable only with explicit authorization: LLM_PROVIDER=gemini, LLM_ALLOW_REMOTE=true.
# Local: LLM_PROVIDER=ollama, LLM_MODEL=gemma4:e4b, LLM_TIMEOUT_SEC=12.
# Ollama defaults to http://127.0.0.1:11434/v1; thinking is disabled for NLU.
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_ALLOW_REMOTE=false
# Gemini default: gemini-3.5-flash-lite, official HTTPS endpoint.
LLM_TIMEOUT_SEC=5
# Maximum output tokens for structured NLU JSON, not the spoken template.
LLM_MAX_TOKENS=256

# Core session limits
MAX_SESSIONS=256
SESSION_TTL_MINUTES=10

# System-1 Decision Model (THX-01 / mmBERT). Evaluates typed questions in a single forward pass.
DECISION_MODEL_ENABLED=true
DECISION_MODEL_URL=http://127.0.0.1:8000/v1/decide
DECISION_DEVICE=cpu
DECISION_MODEL_PATH=doofz/THX-01
DECISION_MOCK=false
DECISION_TIMEOUT_MS=1500
DECISION_THREADS=4

AI_WORKER_HOST=127.0.0.1
AI_WORKER_PORT=8000
AI_WORKER_URL=http://127.0.0.1:8000
AI_API_TOKEN=
DEVICE=auto
ASR_MODEL=small
# Pin to a Hugging Face revision or use an absolute local model path for deployment.
ASR_MODEL_REVISION=
MODELS_OFFLINE=false
TTS_SPEAKER=kseniya

TELEPHONY_ENABLED=true
FASTAGI_PORT=4573
AUDIOSOCKET_PORT=9092
MAX_VOICE_CALLS=8
ASTERISK_AMI_ADDRESS=127.0.0.1:5038
ASTERISK_AMI_USER=tochka
ASTERISK_AMI_SECRET=
# Only for an explicitly initiated mock demo. Forbidden with MIS_API_TOKEN.
ALLOW_DEMO_CALLS_OUTSIDE_WINDOW=false

# Opt-in local mock diagnostics: includes recognized text and bot replies, no audio.
# Logs rotate at 5 MiB (one backup per service); disable and restart after testing.
DEBUG_DIALOGUE=false
DEBUG_LOG_DIR=var/debug

# Technical metadata only: states, issue codes, timings and signal levels.
TECHNICAL_LOG_DIR=var/log
# Explicitly authorized text transcripts; AES-256-GCM, no audio recording.
# Create a private local key first: ./go-core/bin/transcripts -init-key
TRANSCRIPT_LOGGING=false
TRANSCRIPT_LOG_DIR=var/transcripts
TRANSCRIPT_KEY_PATH=var/secrets/transcripts.key
TRANSCRIPT_RETENTION_HOURS=24
