# ==============================================================================
# Tochka Voice Assistant — Конфигурация окружения
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Провайдер (Gemini 3.5 Flash Lite / OpenAI)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Опционально для кастомного OpenAI-совместимого эндпоинта:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# ------------------------------------------------------------------------------
# 2. Go Core Server (Диалоговый менеджер FSM & Slot Manager)
# ------------------------------------------------------------------------------
PORT=8080
NATS_URL=nats://localhost:4222

# ------------------------------------------------------------------------------
# 3. AI Worker (FastAPI: Faster-Whisper ASR + Silero TTS v4 + Normalizer)
# ------------------------------------------------------------------------------
AI_WORKER_HOST=0.0.0.0
AI_WORKER_PORT=8000
AI_WORKER_URL=http://localhost:8000
DEVICE=cuda
TTS_SPEAKER=kseniya
TTS_SAMPLE_RATE=24000

# ------------------------------------------------------------------------------
# 4. Asterisk Telephony (ARI & SIP)
# ------------------------------------------------------------------------------
ASTERISK_ARI_URL=http://localhost:8088/ari
ASTERISK_USER=asterisk
ASTERISK_SECRET=asterisk
ASTERISK_APP=tochka-voice
